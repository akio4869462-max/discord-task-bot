# 開発用（task-bot-dev）の設定。
# このファイルをコピーして .env.dev を作り、値を埋めてください。
#   cp .env.dev.example .env.dev
#
# ⭕ .env.dev は .gitignore 済みなのでコミットされません。
# ⭕ 本番の .env は書き換えません。起動時にこちらを読み込みます。

# task-bot-dev の Bot トークン（TaskManagerBot のものを入れないこと）
DISCORD_TOKEN=

# テストサーバーのチャンネルID
NEWS_CHANNEL_ID=
TASK_CHANNEL_ID=

# 空のままにしておくと、テスト中に本物のGoogleカレンダーへ予定を作りません
GOOGLE_CALENDAR_ID=
